Cell[5470, 127, 312, 5, 70, "Text",ExpressionUUID->"87ee43a1-b3aa-4269-a984-3bec1ebf17b0"],
Cell[5785, 134, 319, 5, 70, "Text",ExpressionUUID->"a6aebb42-2319-49db-aa93-1b95f6d9f972"],
Cell[6107, 141, 286, 6, 70, "Input",ExpressionUUID->"85666e85-8005-492d-b44b-a87d8a16240f"],
Cell[6396, 149, 91, 0, 70, "Section",ExpressionUUID->"d04dae90-0752-48c5-956c-4b305100cba1"],
Cell[6490, 151, 160, 3, 70, "Input",ExpressionUUID->"02e2584d-8bdf-4fe8-b066-edc51e9fdebf"],
Cell[6653, 156, 536, 8, 70, "Text",ExpressionUUID->"6bbb1ec1-1be6-4ff9-b6a2-ee73d9f6e2f7"],
Cell[7192, 166, 154, 1, 70, "Section",ExpressionUUID->"7527e975-7c9b-4342-af42-b355ffebced2"],
Cell[7349, 169, 256, 4, 70, "Input",ExpressionUUID->"3e252829-dea9-42bd-afdc-19234cecacd4"],
